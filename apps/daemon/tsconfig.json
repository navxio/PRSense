{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "composite": true,

    "rootDir": "src",
    "outDir": "dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "lib": ["ES2022"],
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noEmitOnError": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
