{
  "name": "@prsense/daemon",
  "private": false,
  "version": "0.4.0",
  "type": "module",
  "description": "Self hosted PRSense daemon for automated PR review via webhooks",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": "https://github.com/navxio/prsense",
  "homepage": "https://prsense.org",
  "bin": {
    "prsense-daemon": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prepack": "pnpm build",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "clean": "rm -rf dist/ *.tsbuildinfo"
  },
  "dependencies": {
    "@prsense/config": "workspace:*",
    "@prsense/context": "workspace:*",
    "@prsense/core": "workspace:*",
    "@prsense/logging": "workspace:*",
    "@prsense/reporters": "workspace:*",
    "@prsense/workflows": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "cli",
    "pull-request",
    "code-review",
    "automation",
    "ai",
    "developer-tools",
    "llm",
    "self-hosted",
    "webhook",
    "github-app",
    "gitlab-webhook",
    "code-review-bot"
  ],
  "engines": {
    "node": ">=22"
  }
}
