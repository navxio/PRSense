{
  "name": "@prsense/daemon",
  "private": false,
  "version": "0.11.0",
  "type": "module",
  "description": "Self hosted PRSense daemon for automated PR review via webhooks",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": "https://github.com/navxio/prsense",
  "homepage": "https://prsense.org",
  "bin": {
    "prsense-daemon": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@gitbeaker/rest": "^43.8.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "openai": "^6.16.0",
    "pg": "^8.17.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "sqlite-vec": "^0.1.9",
    "ts-morph": "^28.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@prsense/config": "workspace:*",
    "@prsense/context": "workspace:*",
    "@prsense/core": "workspace:*",
    "@prsense/logging": "workspace:*",
    "@prsense/reporters": "workspace:*",
    "@prsense/workflows": "workspace:*",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "cli",
    "pull-request",
    "code-review",
    "automation",
    "ai",
    "developer-tools",
    "llm",
    "self-hosted",
    "webhook",
    "github-app",
    "gitlab-webhook",
    "code-review-bot"
  ],
  "engines": {
    "node": ">=22 <25"
  }
}
