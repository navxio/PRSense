{
  "name": "@prsense/cli",
  "version": "0.3.1",
  "description": "Command line interface to PRSense",
  "type": "module",
  "bin": {
    "prsense": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "dev:review": "tsx src/index.ts review .",
    "clean": "rm -rf dist/ *.tsbuildinfo"
  },
  "keywords": [
    "cli",
    "pull-request",
    "code-review",
    "automation",
    "ai",
    "developer-tools",
    "llm"
  ],
  "author": "Navdeep Saini",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/navxio/prsense",
    "directory": "apps/cli"
  },
  "homepage": "https://prsense.org",
  "bugs": "https://github.com/navxio/prsense/issues",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@prsense/config": "workspace:*",
    "@prsense/context": "workspace:*",
    "@prsense/core": "workspace:*",
    "@prsense/logging": "workspace:*",
    "@prsense/preflight": "workspace:*",
    "@prsense/reporters": "workspace:*",
    "@prsense/workflows": "workspace:*",
    "commander": "^14.0.2",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
