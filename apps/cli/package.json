{
  "name": "@prsense/cli",
  "version": "0.15.0",
  "description": "Command line interface to PRSense",
  "type": "module",
  "man": "./man/prsense.1",
  "files": [
    "dist",
    "man"
  ],
  "bin": {
    "prsense": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsup --watch",
    "dev:review": "tsx src/index.ts review .",
    "clean": "rm -rf dist/ *.tsbuildinfo"
  },
  "keywords": [
    "cli",
    "pull-request",
    "code-review",
    "automation",
    "ai",
    "developer-tools",
    "llm"
  ],
  "author": "Navdeep Saini",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/navxio/prsense",
    "directory": "apps/cli"
  },
  "homepage": "https://prsense.org",
  "bugs": "https://github.com/navxio/prsense/issues",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@gitbeaker/rest": "^43.8.0",
    "@google/genai": "^2.8.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "got": "^11.8.6",
    "openai": "^6.16.0",
    "pg": "^8.17.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "sqlite-vec": "^0.1.9",
    "ts-morph": "^28.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@prsense/config": "workspace:*",
    "@prsense/context": "workspace:*",
    "@prsense/core": "workspace:*",
    "@prsense/logging": "workspace:*",
    "@prsense/preflight": "workspace:*",
    "@prsense/reporters": "workspace:*",
    "@prsense/workflows": "workspace:*",
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
