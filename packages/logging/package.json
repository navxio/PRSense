{
  "name": "@prsense/logging",
  "version": "0.0.1",
  "description": "Structured logging primitives for PRSense",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
