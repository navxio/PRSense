  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "pino": "^10.3.0"
  }
}
