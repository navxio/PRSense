{
  "name": "@prsense/context",
  "version": "0.4.0",
  "description": "Context retrieval (RAG) subsystem for PRsense",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/migrations/*.sql dist/migrations/",
    "prepack": "pnpm build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@octokit/rest": "^22.0.1",
    "@prsense/core": "workspace:*",
    "pg": "^8.17.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
