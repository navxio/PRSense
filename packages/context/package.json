{
  "name": "@prsense/context",
  "version": "0.4.0",
  "description": "Context retrieval (RAG) subsystem for PRsense",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@prsense/core": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "sqlite-vec": "^0.1.9",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
