{
  "name": "prsense-meta",
  "version": "0.11.3",
  "private": true,
  "description": "An open-source, LLM-powered pull request reviewer that surfaces high-confidence issues as structured signals.",
  "main": "index.js",
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "build:config": "pnpm --filter @prsense/config build",
    "build:cli": "pnpm --filter @prsense/cli build",
    "build:core": "pnpm --filter @prsense/core build",
    "build:context": "pnpm --filter @prsense/context build",
    "build:llm": "pnpm --filter @prsense/llm build",
    "build:reporters": "pnpm --filter @prsense/reporters build",
    "build:workflows": "pnpm --filter @prsense/workflows build",
    "build:preflight": "pnpm --filter @prsense/preflight build",
    "build:logging": "pnpm --filter @prsense/logging build",
    "build:daemon": "pnpm --filter @prsense/daemon build",
    "build:bench": "pnpm --filter @prsense/bench build",
    "cli:review": "pnpm --filter @prsense/cli dev:review",
    "dev:cli": "pnpm --filter @prsense/cli dev",
    "cli:doctor": "pnpm --filter @prsense/cli start -- doctor",
    "db:shell": "psql -h localhost -p 10000 -U prsense prsense_dev",
    "daemon": "pnpm --filter @prsense/daemon dev",
    "bench": "pnpm --filter @prsense/bench start",
    "test": "jest --runInBand",
    "publish:check": "pnpm -r build && pnpm -r pack",
    "publish": "pnpm publish -r --access public --no-git-checks"
  },
  "keywords": [
    "cli",
    "pull-request",
    "code-review",
    "automation",
    "ai",
    "developer-tools",
    "llm",
    "rag",
    "retrieval-augmented-generation"
  ],
  "author": "Navdeep Saini",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22 <25"
  },
  "bugs": "https://github.com/navxio/prsense/issues",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  }
}
