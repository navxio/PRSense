{
  "name": "prsense",
  "version": "0.0.0",
  "description": "An open-source, LLM-powered pull request reviewer that surfaces high-confidence issues as structured signals.",
  "main": "index.js",
  "scripts": {
    "build:config": "pnpm --filter @prsense/config build",
    "build:cli": "pnpm --filter @prsense/cli build",
    "build:domain": "pnpm --filter @prsense/domain build",
    "build:engine": "pnpm --filter @prsense/engine build",
    "cli:review": "pnpm --filter @prsense/cli dev:review"
  },
  "keywords": [],
  "author": "Navdeep Saini",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.27.0",
  "volta": {
    "node": "24.12.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
